{
  "name": "MartialMatch Viewer (dev test)",
  "short_name": "MM Test",
  "description": "Filter athletes and follow live fights from MartialMatch events.",
  "start_url": "pl/events/current-matches/?tab=events",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#12141a",
  "theme_color": "#12141a",
  "capture_links": "existing-client-navigate",
  "icons": [
    {
      "src": "icons/icon-192-dev-test.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-dev-test.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-dev-test.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
